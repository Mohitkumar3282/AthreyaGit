# ==========================================
# Athreya Delivery Backend Production Environment
# ==========================================

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/athreya?retryWrites=true&w=majority

# Server Config
PORT=7000
NODE_ENV=production
PROCESS_ROLE=all
HOSTNAME=athreyadelivery.com
TRUST_PROXY=true

# Frontend URL & CORS
FRONTEND_URL=http://athreyadelivery.com
CORS_ALLOWED_ORIGINS=http://athreyadelivery.com,https://athreyadelivery.com,http://www.athreyadelivery.com,https://www.athreyadelivery.com

# Cloudinary
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Firebase
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT='{
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "your_private_key_id",
  "private_key": "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...placeholder...\n-----END PRIVATE KEY-----\n",
  "client_email": "firebase-adminsdk@your-project-id.iam.gserviceaccount.com",
  "client_id": "000000000000000000000",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk@your-project-id.iam.gserviceaccount.com",
  "universe_domain": "googleapis.com"
}'

# Redis (Set REDIS_DISABLED=true if not using local/hosted Redis)
REDIS_DISABLED=true
# REDIS_URL=redis://localhost:6379

DEFAULT_DELIVERY_TIMEOUT_MS=60000
DELIVERY_BROADCAST_REQUIRE_VERIFIED=true

GOOGLE_MAPS_API_KEY=your_google_maps_api_key
MAPS_RL_USER_PER_MIN=30
MAPS_RL_IP_PER_MIN=60
PICKUP_RADIUS_METERS=5000
RETURN_WINDOW_MINUTES=2

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=4
OTP_MAX_FAILED_ATTEMPTS=5
OTP_SEND_RATE_LIMIT_MAX=5
OTP_SEND_RATE_LIMIT_WINDOW_MS=900000
OTP_VERIFY_RATE_LIMIT_MAX=10
OTP_VERIFY_RATE_LIMIT_WINDOW_MS=900000

USE_MOCK_OTP=true
USE_REAL_SMS=false

# PhonePe PG
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_SECRET=
API_BASE_URL=https://api-preprod.phonepe.com

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Athreya

# API Payload Limits
API_JSON_LIMIT=50mb
API_URLENCODED_LIMIT=50mb
